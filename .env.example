# This file documents the server environment expected by the application.
# It is not loaded automatically: configure the values in Apache/PHP or in
# the deployment environment. Never commit the real .env file.

APP_ENV=local

DB_HOST=localhost
DB_PORT=3306
DB_NAME=arbitri_app
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=arbitri-app
JWT_EXPIRE=3600

FOOTBALL_SYNC_ENCRYPTION_KEY=replace-with-a-different-stable-random-secret

GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=arbitri-app/1.0
GEOCODING_TIMEOUT=8

# Used only by: php database/bootstrap_admin.php
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
