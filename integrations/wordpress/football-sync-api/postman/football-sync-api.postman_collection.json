{
  "info": {
    "_postman_id": "b55fcb81-7f98-4f2e-94f1-9bbda11f7b25",
    "name": "Football Sync API",
    "description": "Collection per verificare il plugin WordPress Football Sync API e i dati AnWP normalizzati per arbitri-app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response JSON valida', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('success', true);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Diagnostica",
      "item": [
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "info"
              ]
            },
            "description": "Verifica plugin, autenticazione, versione WordPress e disponibilita delle tabelle AnWP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sincronizzazione",
      "item": [
        {
          "name": "Sync incrementale",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.indexed_at) {",
                  "    pm.collectionVariables.set('updatedAfter', body.indexed_at);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sync?updated_after={{updatedAfter}}&refresh={{syncRefresh}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sync"
              ],
              "query": [
                {
                  "key": "updated_after",
                  "value": "{{updatedAfter}}"
                },
                {
                  "key": "refresh",
                  "value": "{{syncRefresh}}"
                }
              ]
            },
            "description": "Aggiorna l'indice e restituisce ID modificati o cancellati. Dopo una risposta valida salva indexed_at nella variabile updatedAfter."
          },
          "response": []
        }
      ]
    },
