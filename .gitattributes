* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.htaccess text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary

# Bundled frontend dependencies keep their upstream formatting and are treated
# as vendored code by GitHub language statistics.
admin/dist/** -whitespace linguist-vendored
admin/plugins/** -whitespace linguist-vendored
